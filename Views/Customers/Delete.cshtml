@model StokTakipUygulamasi.Models.Customer

@{
    ViewData["Title"] = "Müşteri Sil";
}

<div class="max-w-xl bg-white rounded-sm shadow-sm border border-red-200 overflow-hidden">
    <div class="bg-red-50 border-b border-red-100 px-6 py-4 flex items-center space-x-3">
        <div class="bg-red-100 text-red-600 p-2 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6" />
            </svg>
        </div>
        <div>
            <h3 class="text-red-800 font-bold text-lg">Müşteri Kaydını Siliyorsunuz!</h3>
            <p class="text-red-600 text-sm">Eğer müşterinin geçmiş siparişleri varsa silme işlemi hata verebilir.</p>
        </div>
    </div>

    <div class="p-6">
        <div class="mb-6 space-y-4">
            <div>
                <p class="text-xs text-gray-500 uppercase font-semibold tracking-wider">Müşteri Adı Soyadı</p>
                <p class="text-xl font-bold text-gray-800 mt-1">@Model.FirstName @Model.LastName</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs text-gray-500 uppercase font-semibold tracking-wider">Telefon</p>
                    <p class="text-gray-800">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 uppercase font-semibold tracking-wider">E-Posta</p>
                    <p class="text-gray-800">@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</p>
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="flex items-center space-x-3 pt-4 border-t border-gray-100">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-sm text-sm font-medium transition shadow">
                Evet, Müşteriyi Sil
            </button>
            <a href="/Customers" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-2 rounded-sm text-sm font-medium transition">
                Vazgeç
            </a>
        </form>
    </div>
</div>