@model IEnumerable<StokTakipUygulamasi.Models.Order>
@using StokTakipUygulamasi.Models

@{
    ViewData["Title"] = "Siparişler";
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <form asp-action="Index" method="get" class="flex w-full md:w-auto">
        <input type="text" name="searchString" value="@ViewBag.SearchString" placeholder="Sipariş No veya Müşteri ara..." class="w-full md:w-64 border border-gray-300 rounded-l-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm" />
        <button type="submit" class="bg-slate-700 hover:bg-slate-800 text-white px-4 py-2 rounded-r-sm text-sm font-medium transition">Ara</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchString))
        {
            <a href="/Orders" class="flex items-center text-slate-500 hover:text-red-500 px-3 text-sm font-medium transition">Temizle</a>
        }
    </form>

    <div class="flex items-center space-x-3 w-full md:w-auto">
        <a href="/Orders/ExportToExcel" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-sm text-sm font-medium transition shadow">Excel'e Aktar</a>
        <a href="/Orders/Create" class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-sm text-sm font-medium transition shadow">+ Yeni Sipariş</a>
    </div>
</div>

<div class="bg-white rounded-sm shadow overflow-hidden border border-gray-200">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200 text-gray-500 text-sm">
                    <th class="px-6 py-3 font-medium">Sipariş No</th>
                    <th class="px-6 py-3 font-medium">Tarih</th>
                    <th class="px-6 py-3 font-medium">Müşteri</th>
                    <th class="px-6 py-3 font-medium text-center">Durum</th>
                    <th class="px-6 py-3 font-medium text-right">Tutar</th>
                    <th class="px-6 py-3 font-medium text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-gray-100 hover:bg-emerald-50 transition">
                        <td class="px-6 py-4 text-gray-800 font-bold">#@item.Id</td>
                        <td class="px-6 py-4 text-gray-600 text-sm">@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="px-6 py-4 text-gray-800 font-medium">@item.Customer?.FirstName @item.Customer?.LastName</td>
                        
                        <!-- ENUM'A GÖRE RENKLİ ROZET -->
                        <td class="px-6 py-4 text-center">
    @{
        var badgeColor = item.Status switch {
            OrderStatus.Bekliyor => "bg-yellow-100 text-yellow-800 border-yellow-200",
            OrderStatus.Hazirlaniyor => "bg-blue-100 text-blue-800 border-blue-200",
            OrderStatus.Tamamlandi => "bg-green-100 text-green-800 border-green-200",
            OrderStatus.Iptal => "bg-red-100 text-red-800 border-red-200",
            _ => "bg-gray-100 text-gray-800"
        };

        var statusText = item.Status switch {
            OrderStatus.Bekliyor => "Bekliyor",
            OrderStatus.Hazirlaniyor => "Hazırlanıyor",
            OrderStatus.Tamamlandi => "Tamamlandı",
            OrderStatus.Iptal => "İptal",
            _ => item.Status.ToString()
        };
    }
    <span class="px-3 py-1 rounded-none text-xs font-bold border @badgeColor">
        @statusText
    </span>
</td>

                        <td class="px-6 py-4 text-gray-800 font-medium text-right">@item.TotalAmount.ToString("N2") ₺</td>
                        <td class="px-6 py-4 text-center">
                            <a href="/Orders/Details/@item.Id" class="text-emerald-600 hover:text-emerald-800 text-sm font-bold transition">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SAYFALAMA -->
@if (ViewBag.TotalPages > 1)
{
    <div class="flex justify-center items-center mt-6 space-x-1">
        @if (ViewBag.CurrentPage > 1) { <a href="/Orders?page=@(ViewBag.CurrentPage - 1)" class="px-3 py-1 border rounded-sm text-sm">Önceki</a> }
        @for (int i = 1; i <= ViewBag.TotalPages; i++) { <a href="/Orders?page=@i" class="px-3 py-1 border rounded-sm text-sm @(i == ViewBag.CurrentPage ? "bg-emerald-500 text-white" : "")">@i</a> }
        @if (ViewBag.CurrentPage < ViewBag.TotalPages) { <a href="/Orders?page=@(ViewBag.CurrentPage + 1)" class="px-3 py-1 border rounded-sm text-sm">Sonraki</a> }
    </div>
}