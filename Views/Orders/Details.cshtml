@model StokTakipUygulamasi.Models.Order
@using StokTakipUygulamasi.Models

@{
    ViewData["Title"] = "Sipariş Detayı (#" + Model.Id + ")";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-emerald-50 text-emerald-600 p-4 rounded-none text-sm font-medium mb-6 border border-emerald-200">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-50 text-red-600 p-4 rounded-none text-sm font-medium mb-6 border border-red-200">
        @TempData["ErrorMessage"]
    </div>
}

<!-- DURUM GÜNCELLEME BUTONLARI -->
<div class="mt-4 mb-6 flex flex-wrap items-center gap-3 bg-white p-4 rounded-none border border-gray-200 shadow-sm">
    <span class="text-sm font-medium text-gray-700">Durumu Güncelle:</span>
    
    <form asp-action="ChangeStatus" method="post" class="inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="newStatus" value="Bekliyor" />
        <button type="submit" class="px-4 py-2 text-xs font-bold rounded-none bg-yellow-100 text-yellow-800 hover:bg-yellow-200 border border-yellow-200">Bekliyor</button>
    </form>
    
    <form asp-action="ChangeStatus" method="post" class="inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <!-- ARKA PLAN DEĞERİ DÜZELTİLDİ: Hazirlaniyor -->
        <input type="hidden" name="newStatus" value="Hazirlaniyor" />
        <button type="submit" class="px-4 py-2 text-xs font-bold rounded-none bg-blue-100 text-blue-800 hover:bg-blue-200 border border-blue-200">Hazırlanıyor</button>
    </form>
    
    <form asp-action="ChangeStatus" method="post" class="inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <!-- ARKA PLAN DEĞERİ DÜZELTİLDİ: Tamamlandi -->
        <input type="hidden" name="newStatus" value="Tamamlandi" />
        <button type="submit" class="px-4 py-2 text-xs font-bold rounded-none bg-green-100 text-green-800 hover:bg-green-200 border border-green-200">Tamamlandı</button>
    </form>

    <form asp-action="ChangeStatus" method="post" class="inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <!-- ARKA PLAN DEĞERİ DÜZELTİLDİ: Iptal -->
        <input type="hidden" name="newStatus" value="Iptal" />
        <button type="submit" onclick="return confirm('İptal etmek istediğinize emin misiniz?');" class="px-4 py-2 text-xs font-bold rounded-none bg-red-100 text-red-800 hover:bg-red-200 border border-red-200">İptal</button>
    </form>
</div>

<!-- SİPARİŞ BİLGİLERİ VE SEPET -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Sol: Ürün Ekleme -->
    <div class="bg-white p-6 rounded-none border border-gray-200 shadow-sm">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Sepete Ürün Ekle</h3>
        <form asp-action="AddProductToOrder" method="post">
            <input type="hidden" name="OrderId" value="@Model.Id" />
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Ürün Seçin</label>
                <select name="ProductId" class="w-full border border-gray-300 rounded-none px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500">
                    @foreach (var p in ViewBag.Products)
                    {
                        <option value="@p.Id">@p.Name (Stok: @p.StockQuantity - @p.Price ₺)</option>
                    }
                </select>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1">Miktar</label>
                <input type="number" name="Quantity" value="1" min="1" class="w-full border border-gray-300 rounded-none px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500" />
            </div>
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-none text-sm font-medium transition shadow">Sepete Ekle</button>
        </form>
    </div>

    <!-- Sağ: Eklenen Ürünler -->
    <div class="lg:col-span-2 bg-white p-0 rounded-none border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-slate-50 p-4 border-b border-gray-200 flex justify-between items-center">
            <h3 class="font-bold text-gray-800">Sipariş İçeriği</h3>
            <span class="bg-emerald-100 text-emerald-800 font-bold px-4 py-1 rounded-none border border-emerald-200 text-sm">
                Toplam: @Model.TotalAmount.ToString("N2") ₺
            </span>
        </div>
        
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-gray-200 text-gray-500 text-sm">
                    <th class="px-6 py-3 font-medium">Ürün Adı</th>
                    <th class="px-6 py-3 font-medium text-center">Birim Fiyat</th>
                    <th class="px-6 py-3 font-medium text-center">Adet</th>
                    <th class="px-6 py-3 font-medium text-right">Ara Toplam</th>
                    <th class="px-6 py-3 font-medium text-center">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderDetails == null || !Model.OrderDetails.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-500 text-sm">Bu siparişe henüz ürün eklenmemiş.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.OrderDetails)
                    {
                        var rowTotal = item.Quantity * item.UnitPrice;
                        <tr class="border-b border-gray-100 hover:bg-emerald-50 transition">
                            <td class="px-6 py-4 text-gray-800 font-medium">@item.Product.Name</td>
                            <td class="px-6 py-4 text-gray-600 text-center">@item.UnitPrice.ToString("N2") ₺</td>
                            <td class="px-6 py-4 text-gray-800 font-bold text-center">x @item.Quantity</td>
                            <td class="px-6 py-4 text-emerald-600 font-medium text-right">@rowTotal.ToString("N2") ₺</td>
                            <td class="px-6 py-4 text-center">
                                <form asp-action="RemoveProductFromOrder" method="post">
                                    <input type="hidden" name="OrderId" value="@Model.Id" />
                                    <input type="hidden" name="ProductId" value="@item.ProductId" />
                                    <button type="submit" class="text-red-500 hover:text-red-700 text-sm font-bold" onclick="return confirm('Çıkarmak istediğinize emin misiniz?');">Çıkar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>