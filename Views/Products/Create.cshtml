@model StokTakipUygulamasi.Models.Product

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="max-w-2xl bg-white rounded-sm shadow-sm border border-gray-200 p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-6">Ürün Bilgileri</h3>
    
    <form asp-action="Create" method="post">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <div class="col-span-1 md:col-span-2">
                <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Ürün Adı</label>
                <input asp-for="Name" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" placeholder="Örn: Oyuncu Klavyesi" required />
                <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="col-span-1 md:col-span-2">
                <label asp-for="CategoryId" class="block text-sm font-medium text-gray-700 mb-1">Kategori</label>
                <select asp-for="CategoryId" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition bg-white" asp-items="ViewBag.CategoryId" required>
                    <option value="">-- Kategori Seçiniz --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="col-span-1">
                <label asp-for="Price" class="block text-sm font-medium text-gray-700 mb-1">Fiyat (₺)</label>
                <input asp-for="Price" type="number" step="0.01" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" placeholder="0.00" required />
                <span asp-validation-for="Price" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="col-span-1">
                <label asp-for="StockQuantity" class="block text-sm font-medium text-gray-700 mb-1">Stok Miktarı</label>
                <input asp-for="StockQuantity" type="number" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" placeholder="0" required />
                <span asp-validation-for="StockQuantity" class="text-red-500 text-xs mt-1"></span>
            </div>
        </div>

        <div class="flex items-center space-x-3 mt-8 pt-4 border-t border-gray-100">
            <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-2 rounded-sm text-sm font-medium transition shadow">
                Ürünü Kaydet
            </button>
            <a href="/Products" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-2 rounded-sm text-sm font-medium transition">
                İptal
            </a>
        </div>
    </form>
</div>