@model StokTakipUygulamasi.Models.Category

@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="max-w-xl bg-white rounded-sm shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-semibold text-gray-800">Kategori Bilgisini Güncelle</h3>
        <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-sm">ID: #@Model.Id</span>
    </div>
    
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-5">
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Kategori Adı</label>
            <input asp-for="Name" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" required />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="flex items-center space-x-3 mt-6 pt-4 border-t border-gray-100">
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-sm text-sm font-medium transition shadow">
                Değişiklikleri Kaydet
            </button>
            <a href="/Categories" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-2 rounded-sm text-sm font-medium transition">
                İptal
            </a>
        </div>
    </form>
</div>