@{
    // Bu sayfanın sol menüye (Layout'a) ihtiyacı yok, tek başına tam ekran çalışacak!
    Layout = null; 
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş - Stok Takip Sistemi</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 h-screen flex items-center justify-center">

    <div class="bg-white p-8 rounded-sm shadow-md w-full max-w-sm border-t-4 border-emerald-500">
        
        <div class="text-center mb-8">
            <div class="bg-emerald-100 text-emerald-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-800">Sisteme Giriş</h2>
            <p class="text-sm text-gray-500 mt-1">Yönetim paneline erişmek için giriş yapın.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-50 text-red-600 p-3 rounded-sm text-sm font-medium mb-4 text-center border border-red-200">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" method="post" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Kullanıcı Adı</label>
                <input type="text" name="username" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" required />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Şifre</label>
                <input type="password" name="password" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" required />
            </div>

            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 rounded-sm transition shadow mt-4">
                Giriş Yap
            </button>
        </form>
        
        <p class="text-center text-xs text-gray-400 mt-6">Demo: admin / 12345</p>
    </div>

</body>
</html>